<Project>
  <PropertyGroup>
    <UseSharedCompilation>false</UseSharedCompilation>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../.local/tests/$(MSBuildProjectName)/obj/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)../.local/tests/$(MSBuildProjectName)/bin/</BaseOutputPath>
  </PropertyGroup>
</Project>
